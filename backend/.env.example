# バックエンド 環境変数サンプル
# このファイルをコピーして .env（開発用）または Render の Environment Variables に設定してください

# Steam Web API Key
# https://steamcommunity.com/dev/apikey で取得
STEAM_API_KEY=your_steam_api_key_here

# 許可するフロントエンドのオリジン（本番環境用）
# カンマ区切りで複数指定可能
# 例: ALLOWED_ORIGINS=https://steamstats.vercel.app,https://www.example.com
# 未設定の場合は localhost:5173 のみ許可（開発環境用デフォルト）
ALLOWED_ORIGINS=

# JWT署名用シークレットキー（本番環境では必ず強力なランダム文字列を設定してください）
# 例: python -c "import secrets; print(secrets.token_hex(32))" で生成
JWT_SECRET_KEY=your_jwt_secret_key_here
